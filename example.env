# string  [The environment the application is running in]
NODE_ENV=development

# boolean  [Enable swagger]
SWAGGER=false

# string  [The global prefix of the application]
GLOBAL_PREFIX=api/v1

# number  [The port the application will listen to]
PORT=3000

# string  [The level of logging]
LOG_LEVEL=info

# string  [The URL of the client]
CLIENT_URL=http://localhost:3000

# string required [The URI of the MongoDB database]
MONGODB_URI=

# string required [The name of the MongoDB database]
MONGODB_DB_NAME=

# string required [The host of the Redis database]
REDIS_HOST=

# number required [The port of the Redis database]
REDIS_PORT=

# string required [The password of the Redis database]
REDIS_PASSWORD=

# any required [Comma-separated STUN URLs. Required. At least one URL after trim. No default.]
STUN_URLS=

# any required [Comma-separated TURN URLs. Required. At least one URL after trim. No default.]
TURN_URLS=

# any required [TURN username]
TURN_USERNAME=

# any required [TURN credential]
TURN_PASSWORD=

# number  [Pair-block TTL from the moment WebRTC connects]
PAIR_BLOCK_TTL_SECONDS=3600

# number  [Presence key TTL, refreshed by pings]
PRESENCE_TTL_SECONDS=15

# number  [How long a session may stay without connectedAt]
CONNECT_TIMEOUT_SECONDS=20

# number  [Public stats cache TTL]
STATS_CACHE_TTL_SECONDS=10

